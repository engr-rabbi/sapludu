# ───────────────────────────────────────────────────────────────────────────
# Sapludu game server — runtime configuration (set these in your host's
# dashboard, e.g. Render → Environment). NEVER commit a real .env file.
# ───────────────────────────────────────────────────────────────────────────

PORT=3003

# Origins allowed to open a WebSocket (comma separated, no trailing slash).
# Your GitHub Pages origin is https://USERNAME.github.io (no repo path!).
CORS_ORIGINS=http://localhost:3000,https://USERNAME.github.io

# The Apps Script web-app URL (same as NEXT_PUBLIC_APPS_SCRIPT_URL)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# Must equal the SERVER_SECRET *script property* in Apps Script (32+ random chars).
# Generate one by running generateServerSecret() in the Apps Script editor.
APPS_SCRIPT_SERVER_SECRET=

# Optional tuning
# SERVER_ID=render-1
# TURN_TIME_MS=40000            # auto-roll for an idle player
# DISCONNECT_FORFEIT_MS=90000   # forfeit after this long offline during a game
# LOBBY_GRACE_MS=30000          # keep a seat this long after a lobby disconnect
# MIN_ROLL_MS=250               # anti-flood gap between a player's rolls
# PENDING_FILE=./data/pending-results.json   # retry queue persisted here ("" disables)
