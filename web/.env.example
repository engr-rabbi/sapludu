# ───────────────────────────────────────────────────────────────────────────
# Sapludu web app — build-time configuration (copy to web/.env.local)
#
# Every NEXT_PUBLIC_* value is compiled INTO the public JavaScript bundle.
# They are public identifiers, not secrets. Never put a secret in this file.
# ───────────────────────────────────────────────────────────────────────────

# OAuth 2.0 *Web application* client ID from Google Cloud Console
#   (APIs & Services → Credentials). Looks like 1234567890-abc.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apps Script web-app URL (Deploy → Manage deployments → Web app), ends with /exec
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# Public URL of the Socket.IO game server (https://… in production)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:3003

# Only for GitHub Pages *project* sites served from https://USER.github.io/REPO
#   → set to "/REPO". Leave empty for user/org sites and custom domains.
NEXT_PUBLIC_BASE_PATH=
